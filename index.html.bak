<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>赵金成 - AI产品经理</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@100;300;400;500;600;700;900&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --white: #fbfbfd;
            --black: #1d1d1f;
            --gray1: #86868b;
            --gray2: #6e6e73;
            --gray3: #d2d2d7;
            --gray4: #f5f5f7;
            --gray5: #e8e8ed;
            --blue: #2997ff;
            --blue-hover: #0077ed;
            --green: #30d158;
            --purple: #bf5af2;
            --orange: #ff9f0a;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Noto Sans SC', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
            background: var(--white);
            color: var(--black);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            overflow-x: hidden;
        }

        /* ===== Global Nav ===== */
        .globalnav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 9999;
            height: 48px;
            background: rgba(251, 251, 253, 0.8);
            backdrop-filter: saturate(180%) blur(20px);
            -webkit-backdrop-filter: saturate(180%) blur(20px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.08);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .globalnav-content {
            width: 100%;
            max-width: 1024px;
            padding: 0 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .globalnav-logo {
            font-size: 21px;
            font-weight: 600;
            color: var(--black);
            text-decoration: none;
        }

        .globalnav-links {
            display: flex;
            gap: 24px;
            list-style: none;
        }

        .globalnav-links a {
            font-size: 12px;
            color: var(--gray2);
            text-decoration: none;
            transition: color 0.3s;
        }

        .globalnav-links a:hover {
            color: var(--black);
        }

        /* ===== Section Common ===== */
        .section {
            padding: 100px 22px;
        }

        .section-content {
            max-width: 980px;
            margin: 0 auto;
        }

        .section-headline {
            font-size: 48px;
            font-weight: 700;
            letter-spacing: -0.015em;
            line-height: 1.08;
            color: var(--black);
        }

        .section-subhead {
            font-size: 21px;
            font-weight: 400;
            line-height: 1.38;
            color: var(--gray1);
            margin-top: 12px;
            max-width: 600px;
        }

        .section-subhead.centered {
            margin-left: auto;
            margin-right: auto;
            text-align: center;
        }

        .section-eyebrow {
            font-size: 12px;
            font-weight: 600;
            color: var(--gray2);
            text-transform: uppercase;
            letter-spacing: 0.02em;
            margin-bottom: 6px;
        }

        /* ===== Hero - Combined with Resume Info ===== */
        .hero {
            background: var(--white);
            padding: 120px 22px 40px;
        }

        .hero-content {
            max-width: 980px;
            margin: 0 auto;
        }

        .hero-top {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 40px;
            align-items: start;
            margin-bottom: 50px;
        }

        .hero-main {
            max-width: 600px;
        }

        .hero-eyebrow {
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.04em;
            color: var(--gray2);
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .hero-headline {
            font-size: clamp(40px, 6vw, 56px);
            font-weight: 700;
            letter-spacing: -0.03em;
            line-height: 1.05;
            color: var(--black);
            margin-bottom: 16px;
        }

        .hero-headline .highlight {
            background: linear-gradient(90deg, #2997ff, #5ac8fa, #bf5af2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-title {
            font-size: 21px;
            font-weight: 600;
            color: var(--black);
            margin-bottom: 12px;
        }

        .hero-contact {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            font-size: 14px;
            color: var(--gray2);
        }

        .hero-contact span {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .hero-status {
            background: var(--gray4);
            border-radius: 16px;
            padding: 24px 28px;
            min-width: 200px;
        }

        .status-label {
            font-size: 12px;
            color: var(--gray2);
            margin-bottom: 4px;
        }

        .status-value {
            font-size: 15px;
            font-weight: 600;
            color: var(--green);
        }

        /* ===== Advantages Grid (Merged Section) ===== */
        .hero-advantages {
            margin-bottom: 50px;
        }

        .advantages-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }

        .advantage-card {
            background: var(--gray4);
            border-radius: 20px;
            padding: 28px 24px;
            text-align: center;
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .advantage-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
        }

        .advantage-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            margin: 0 auto 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .advantage-icon-1 { background: linear-gradient(135deg, #2997ff, #5ac8fa); }
        .advantage-icon-2 { background: linear-gradient(135deg, #30d158, #63e68a); }
        .advantage-icon-3 { background: linear-gradient(135deg, #ff9f0a, #ffcc02); }

        .advantage-title {
            font-size: 15px;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .advantage-desc {
            font-size: 13px;
            color: var(--gray1);
            line-height: 1.4;
        }

        /* ===== Education (Compact) ===== */
        .hero-education {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 50px;
            padding: 20px 24px;
            background: var(--gray4);
            border-radius: 16px;
        }

        .edu-logo {
            width: 72px;
            height: 72px;
            border-radius: 12px;
            object-fit: contain;
            flex-shrink: 0;
            background: rgba(255, 255, 255, 0.8);
            padding: 6px;
        }

        .edu-info {
            flex: 1;
        }

        .edu-school {
            font-size: 15px;
            font-weight: 600;
            color: var(--black);
            margin-bottom: 2px;
        }

        .edu-details {
            font-size: 13px;
            color: var(--gray1);
        }

        /* ===== Career Timeline (compact) ===== */
        .hero-career {
            margin-top: 50px;
            padding-top: 50px;
            border-top: 1px solid var(--gray5);
        }

        .career-title {
            font-size: 12px;
            font-weight: 600;
            color: var(--gray2);
            text-transform: uppercase;
            letter-spacing: 0.02em;
            margin-bottom: 24px;
        }

        .career-list {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .career-item {
            padding: 24px;
            background: var(--gray4);
            border-radius: 16px;
        }

        .career-period {
            font-size: 12px;
            color: var(--blue);
            font-weight: 600;
            margin-bottom: 6px;
        }

        .career-company {
            font-size: 17px;
            font-weight: 700;
            color: var(--black);
            margin-bottom: 2px;
        }

        .career-role {
            font-size: 13px;
            color: var(--gray2);
            margin-bottom: 10px;
        }

        .career-achievements {
            list-style: none;
            padding: 0;
        }

        .career-achievements li {
            font-size: 13px;
            color: var(--gray1);
            line-height: 1.5;
            padding-left: 16px;
            position: relative;
            margin-bottom: 4px;
        }

        .career-achievements li::before {
            content: '';
            position: absolute;
            left: 0;
            top: 8px;
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--blue);
        }

        /* ===== Products Section ===== */
        .products-section {
            background: var(--white);
            padding: 100px 22px;
        }

        .products-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .product-card {
            background: var(--gray4);
            border-radius: 24px;
            padding: 50px;
            margin-bottom: 24px;
        }

        .product-card:last-child {
            margin-bottom: 0;
        }

        .product-eyebrow {
            font-size: 12px;
            font-weight: 600;
            color: var(--blue);
            text-transform: uppercase;
            letter-spacing: 0.02em;
            margin-bottom: 8px;
        }

        .product-name {
            font-size: 32px;
            font-weight: 700;
            color: var(--black);
            margin-bottom: 8px;
        }

        .product-tagline {
            font-size: 17px;
            color: var(--gray1);
            margin-bottom: 32px;
            font-style: italic;
        }

        /* Product Diagrams */
        .product-diagram {
            background: var(--white);
            border-radius: 16px;
            padding: 32px;
            margin: 28px 0;
            border: 1px solid var(--gray5);
        }

        .diagram-title {
            font-size: 13px;
            font-weight: 600;
            color: var(--gray2);
            text-transform: uppercase;
            letter-spacing: 0.02em;
            margin-bottom: 20px;
            text-align: center;
        }

        .diagram-flow {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .flow-node {
            background: linear-gradient(135deg, #f5f5f7, #ffffff);
            border: 2px solid var(--gray5);
            border-radius: 12px;
            padding: 16px 20px;
            text-align: center;
            min-width: 100px;
            transition: all 0.3s;
        }

        .flow-node:hover {
            border-color: var(--blue);
            transform: translateY(-2px);
        }

        .flow-node.primary {
            background: linear-gradient(135deg, #2997ff, #5ac8fa);
            border-color: transparent;
            color: white;
        }

        .flow-node.primary .node-label {
            color: white;
        }

        .flow-node.ai {
            background: linear-gradient(135deg, #bf5af2, #da8fff);
            border-color: transparent;
            color: white;
        }

        .flow-node.ai .node-label {
            color: white;
        }

        .node-icon {
            font-size: 24px;
            margin-bottom: 6px;
        }

        .node-label {
            font-size: 13px;
            font-weight: 600;
            color: var(--black);
        }

        .flow-arrow {
            font-size: 20px;
            color: var(--gray3);
        }

        .diagram-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-top: 24px;
        }

        .stat-box {
            background: var(--gray4);
            border-radius: 12px;
            padding: 20px;
            text-align: center;
        }

        .stat-number {
            font-size: 28px;
            font-weight: 700;
            color: var(--blue);
            line-height: 1;
        }

        .stat-number .stat-unit {
            font-size: 14px;
            font-weight: 400;
            color: var(--gray2);
            margin-left: 2px;
        }

        .stat-label {
            font-size: 12px;
            color: var(--gray2);
            margin-top: 6px;
        }

        .product-body {
            font-size: 15px;
            line-height: 1.7;
            color: var(--gray2);
        }

        .product-body h4 {
            font-size: 17px;
            font-weight: 600;
            color: var(--black);
            margin: 24px 0 12px;
        }

        .product-body h4:first-child {
            margin-top: 0;
        }

        .product-body p {
            margin-bottom: 12px;
        }

        .product-body ul {
            margin: 12px 0;
            padding-left: 20px;
        }

        .product-body li {
            margin-bottom: 8px;
        }

        .product-body strong {
            color: var(--black);
        }

        .product-highlight {
            display: inline-block;
            background: linear-gradient(90deg, var(--blue), var(--purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 600;
        }

        /* ===== Q&A Section - Collapsible ===== */
        .qa-section {
            background: var(--white);
            padding: 80px 22px;
        }

        .qa-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .qa-toggle-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--black);
            color: var(--white);
            border: none;
            border-radius: 980px;
            padding: 14px 28px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .qa-toggle-btn:hover {
            background: var(--gray2);
            transform: scale(1.02);
        }

        .qa-toggle-btn .chevron {
            transition: transform 0.3s;
        }

        .qa-toggle-btn.active .chevron {
            transform: rotate(180deg);
        }

        .qa-content {
            max-width: 780px;
            margin: 0 auto;
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.5s ease, opacity 0.3s ease;
            opacity: 0;
        }

        .qa-content.show {
            max-height: 2000px;
            opacity: 1;
        }

        .qa-item {
            background: var(--gray4);
            border-radius: 16px;
            padding: 28px 32px;
            margin-bottom: 16px;
        }

        .qa-item:last-child {
            margin-bottom: 0;
        }

        .qa-question {
            font-size: 16px;
            font-weight: 600;
            color: var(--black);
            padding-left: 28px;
            position: relative;
        }

        .qa-question::before {
            content: 'Q';
            position: absolute;
            left: 0;
            top: 0;
            width: 20px;
            height: 20px;
            background: var(--blue);
            color: var(--white);
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* ===== Achievements Section ===== */
        .achievements-section {
            background: var(--gray4);
            padding: 100px 22px;
        }

        .achievements-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .achievements-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
            max-width: 980px;
            margin: 0 auto;
        }

        .achievement-card {
            background: var(--white);
            border-radius: 20px;
            padding: 32px;
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .achievement-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
        }

        .achievement-card.highlight {
            background: linear-gradient(135deg, var(--blue), #5ac8fa);
            color: white;
        }

        .achievement-card.highlight .achievement-number,
        .achievement-card.highlight .achievement-label,
        .achievement-card.highlight .achievement-desc {
            color: white;
        }

        .achievement-number {
            font-size: 48px;
            font-weight: 700;
            line-height: 1;
            margin-bottom: 8px;
            color: var(--blue);
        }

        .achievement-label {
            font-size: 14px;
            font-weight: 600;
            color: var(--gray2);
            margin-bottom: 12px;
        }

        .achievement-desc {
            font-size: 13px;
            color: var(--gray1);
            line-height: 1.6;
        }

        /* ===== Insights Section ===== */
        .insights-section {
            background: var(--white);
            padding: 100px 22px;
        }

        .insights-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .insights-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
            max-width: 980px;
            margin: 0 auto;
        }

        .insight-card {
            background: var(--gray4);
            border-radius: 20px;
            padding: 32px;
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .insight-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
        }

        .insight-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin-bottom: 16px;
        }

        .insight-icon-1 { background: linear-gradient(135deg, #ff6b6b, #ff8e8e); }
        .insight-icon-2 { background: linear-gradient(135deg, #4ecdc4, #7eddd6); }

        .insight-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--black);
            margin-bottom: 12px;
        }

        .insight-desc {
            font-size: 14px;
            color: var(--gray1);
            line-height: 1.7;
        }

        .insight-highlight {
            display: inline-block;
            background: linear-gradient(90deg, var(--blue), var(--purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 600;
        }

        /* ===== Collaboration Section ===== */
        .collab-section {
            background: var(--gray4);
            padding: 100px 22px;
        }

        .collab-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .collab-content {
            max-width: 980px;
            margin: 0 auto;
        }

        .collab-diagram {
            background: var(--white);
            border-radius: 24px;
            padding: 40px;
            margin-bottom: 40px;
        }

        .collab-center {
            display: flex;
            justify-content: center;
            margin-bottom: 32px;
        }

        .collab-core {
            background: linear-gradient(135deg, var(--blue), #5ac8fa);
            color: white;
            padding: 20px 32px;
            border-radius: 16px;
            font-size: 16px;
            font-weight: 600;
            text-align: center;
        }

        .collab-teams {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
        }

        .collab-team {
            background: var(--gray4);
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            transition: all 0.3s;
        }

        .collab-team:hover {
            background: var(--white);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
        }

        .collab-team-icon {
            font-size: 28px;
            margin-bottom: 8px;
        }

        .collab-team-name {
            font-size: 13px;
            font-weight: 600;
            color: var(--black);
        }

        .collab-case {
            background: var(--white);
            border-radius: 20px;
            padding: 32px;
        }

        .collab-case-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--black);
            margin-bottom: 16px;
        }

        .collab-case-desc {
            font-size: 15px;
            color: var(--gray1);
            line-height: 1.8;
        }

        /* ===== Commitment Section ===== */
        .commitment-section {
            background: var(--white);
            padding: 100px 22px;
            text-align: center;
        }

        .commitment-content {
            max-width: 780px;
            margin: 0 auto;
        }

        .commitment-quote {
            font-size: clamp(24px, 3.5vw, 32px);
            font-weight: 700;
            letter-spacing: -0.02em;
            line-height: 1.3;
            color: var(--black);
            margin-bottom: 32px;
        }

        .commitment-quote .gradient-text {
            background: linear-gradient(90deg, #2997ff, #bf5af2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .commitment-points {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 40px;
        }

        .commitment-point {
            background: var(--gray4);
            border-radius: 16px;
            padding: 24px;
        }

        .commitment-point-icon {
            font-size: 32px;
            margin-bottom: 12px;
        }

        .commitment-point-title {
            font-size: 14px;
            font-weight: 600;
            color: var(--black);
            margin-bottom: 8px;
        }

        .commitment-point-desc {
            font-size: 12px;
            color: var(--gray1);
            line-height: 1.5;
        }

        /* ===== Vision Section ===== */
        .vision-section {
            background: var(--gray4);
            padding: 160px 22px;
            text-align: center;
        }

        .vision-content {
            max-width: 680px;
            margin: 0 auto;
        }

        .vision-quote {
            font-size: clamp(28px, 4vw, 40px);
            font-weight: 700;
            letter-spacing: -0.02em;
            line-height: 1.15;
            color: var(--black);
            margin-bottom: 20px;
        }

        .vision-quote .gradient-text {
            background: linear-gradient(90deg, #2997ff, #bf5af2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .vision-desc {
            font-size: 17px;
            color: var(--gray1);
            line-height: 1.5;
        }

        /* ===== Footer ===== */
        footer {
            padding: 24px 22px;
            background: var(--white);
            border-top: 1px solid var(--gray5);
            text-align: center;
        }

        .footer-text {
            font-size: 12px;
            color: var(--gray2);
        }

        /* ===== Animations ===== */
        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                        transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* ===== Responsive ===== */
        @media (max-width: 834px) {
            .globalnav-links {
                display: none;
            }

            .hero-header {
                grid-template-columns: 1fr;
            }

            .hero-status {
                order: -1;
            }

            .hero-highlights {
                grid-template-columns: 1fr;
            }

            .advantages-grid {
                grid-template-columns: 1fr;
            }

            .diagram-flow {
                flex-direction: column;
            }

            .flow-arrow {
                transform: rotate(90deg);
            }

            .diagram-stats {
                grid-template-columns: 1fr;
            }

            .section-headline {
                font-size: 36px;
            }

            .product-card {
                padding: 32px;
            }
        }
    </style>
</head>
<body>

